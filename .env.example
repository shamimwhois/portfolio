# ────────────────────────────────────────────────────────────────
#  Production-ready environment template (cPanel / shared hosting)
# ────────────────────────────────────────────────────────────────
#  Copy this file to `.env` on your server, then run:
#      php artisan key:generate
#  and (if using SQLite):
#      touch database/database.sqlite
#
#  Livewire file uploads (feed photos/videos) are stored on the
#  `local` disk under storage/app/private — make sure the whole
#  `storage/` directory is writable by PHP (755 on folders, 644
#  on files is usually enough; 775 if uploads fail).
# ────────────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────────────
APP_NAME="Sci-Fi HUD Portfolio"
APP_ENV=production

# Leave empty — run `php artisan key:generate` after copying.
APP_KEY=

# IMPORTANT: set this to false in production. Never ship with true.
APP_DEBUG=false

# Use your real HTTPS domain (no trailing slash).
# cPanel: use the addon-domain / main-domain URL, e.g. https://example.com
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ── Logging ─────────────────────────────────────────────────────
# `daily` rotates logs so a single laravel.log never grows forever
# (important on shared hosting with limited disk quotas).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database ────────────────────────────────────────────────────
# SQLite is the zero-setup choice for cPanel: no database creation
# needed, just `touch database/database.sqlite` and ensure it and
# the database/ folder are writable. (This app uses it by default.)
DB_CONNECTION=sqlite

# ---- Prefer MySQL on cPanel? Uncomment and fill in instead: ----
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=your_cpanel_db_name
# DB_USERNAME=your_cpanel_db_user
# DB_PASSWORD=your_cpanel_db_password

# ── Session ─────────────────────────────────────────────────────
# `database` sessions work everywhere on cPanel with zero extra
# config (no file permissions, no Redis needed). Table auto-created
# by the `sessions` migration.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# Set to your bare domain WITHOUT https:// (e.g. .example.com) if
# you want the session cookie to work across www and non-www.
# Leave null otherwise.
SESSION_DOMAIN=null

# Force cookies over HTTPS — keep true on cPanel with SSL.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ── Cache / Queue / Broadcast / Filesystem ──────────────────────
# `database` cache avoids file-permission headaches on shared
# hosting and is already the app default.
CACHE_STORE=database
# CACHE_PREFIX=

# cPanel has no supervisor, so run the queue from cron (see below)
# or keep QUEUE_CONNECTION=database and let the app work without
# a worker (jobs simply won't process until one runs).
# Cron line to add in cPanel → Cron Jobs:
#   * * * * * /usr/local/bin/php /home/USER/public_html/artisan queue:work --stop-when-empty
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Optional: keep Livewire's temporary uploads on the same disk.
# LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

# Not needed unless you opt into Redis/Memcached on a VPS:
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ────────────────────────────────────────────────────────
# cPanel: the local mail server is usually smtp on port 587 (or 465
# with SSL). Use the "Mail Delivery" / email account credentials.
# MAIL_MAILER=log keeps emails in storage/logs — handy for testing.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=your-cpanel-email@your-domain.com
MAIL_PASSWORD=your-email-password
# MAIL_ENCRYPTION=tls

# Where contact-form / notification emails appear to come from.
# Must match an address your host allows (e.g. your cPanel email).
MAIL_FROM_ADDRESS="hello@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Optional third-party services (leave blank if unused) ───────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

POSTMARK_API_KEY=
RESEND_API_KEY=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# ── Frontend (Vite build) ───────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ── Payment gateways (optional env overrides) ───────────────────
# Credentials can be entered in Admin → Settings → Payments instead.
# If set, these env vars override the stored values (useful to keep
# secrets out of the database on production).
# PAYMENTS_STRIPE_SECRET_KEY=
# PAYMENTS_STRIPE_WEBHOOK_SECRET=
# PAYMENTS_BKASH_APP_KEY=
# PAYMENTS_BKASH_APP_SECRET=
# PAYMENTS_BKASH_USERNAME=
# PAYMENTS_BKASH_PASSWORD=
# PAYMENTS_RAZORPAY_KEY_ID=
# PAYMENTS_RAZORPAY_KEY_SECRET=
# PAYMENTS_SSLCOMMERZ_STORE_ID=
# PAYMENTS_SSLCOMMERZ_STORE_PASSWORD=
# PAYMENTS_AMARPAY_STORE_ID=
# PAYMENTS_AMARPAY_SIGNATURE_KEY=
# Binance Pay B2B (https://developers.binance.com/docs/binance-pay) —
# merchant ID + API key (Certificate SN) + secret from the Binance Pay merchant portal.
# PAYMENTS_BINANCE_MERCHANT_ID=
# PAYMENTS_BINANCE_API_KEY=
# PAYMENTS_BINANCE_SECRET_KEY=

# Social login (OAuth2) — Google + GitHub
# Get credentials from Google Cloud Console + GitHub Developer settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# ── Support AI (OpenAI-compatible Chat Completions) ─────────────
# Powers the in-app Support Assistant.
#  - Base URL: OpenAI default. Point at any OpenAI-compatible API
#    (Groq, OpenRouter, local Ollama, etc.) by changing this.
#  - API key: leave empty to run the assistant in offline fallback
#    mode. Never commit a real key — set it only in .env.
#  - Model: keep an affordable, capable model (gpt-4o-mini etc.).
USER_LLM_BASE_URL=https://api.openai.com/v1
USER_LLM_API_KEY=
USER_LLM_MODEL=gpt-4o-mini
USER_LLM_TIMEOUT=30
USER_LLM_MAX_TOKENS=500
